{
  "name": "xlsx-corpus-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Round-trip fidelity harness for XLSX libraries: does read->write preserve the document?",
  "scripts": {
    "corpus": "tsx src/corpus/generate.ts",
    "corpus:real": "tsx src/corpus/fetch.ts",
    "harness": "tsx src/harness/run.ts",
    "bench": "npm run corpus && npm run harness",
    "format": "biome format --write src",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "verify": "./verify.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2"
  }
}
